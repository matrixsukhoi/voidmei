target/
build/
dist/
# 派生数据：由 wt_ext_cli 从游戏客户端解包生成，不进 git（云端备份在 data prerelease 附件）
# 锚定仓库根 — 裸 `data/` 会把 crates/data 源码目录里的 data/ 子目录也忽略掉
/data/
# 运行时生成物：用户数据与日志 (锚定仓库根 — 裸 `config/` 会把源码目录也匹配掉,
# 且令 rg/Grep 等遵守 gitignore 的工具静默跳过该目录, 曾致配置键断链漏检)
records/
/config/
ui_layout.user.cfg*
formulas.user.cfg*
output.log
error.log
# overlay config.rs 位置持久化 (运行时生成, CWD 相对)
build.manifest
# 构建产物
*.zip
*.exe
*.dll
*.csv
# voice/ 根目录自带 wav 进 git；voice/<pack>/ 子目录是用户安装的自定义语音包（运行时数据）
voice/*/
# 商业字体不进公开仓库（本地保留可用，分发不带，程序容错回退）
fonts/DIN Pro 400.otf

# fmdata 游戏目录探测缓存
.wt_game_dir

# web 前端 (webui): 依赖不入库 (dist/target 已被上方裸规则 target/、dist/
# 覆盖; pnpm-lock.yaml 必须入库锁定依赖, dist 由 cargo 编译期嵌入)
node_modules/

*.pyc
user_pos.json
voidmei_config.json*
