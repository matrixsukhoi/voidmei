{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidMei",
  "version": "0.2.0",
  "identifier": "org.voidmei.desktop",
  "build": {
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoidMei 设置",
        "width": 800,
        "height": 620,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**/image/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
